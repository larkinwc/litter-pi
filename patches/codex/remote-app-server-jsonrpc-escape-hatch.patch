+    /// Litter extension: dispatch a JSON-RPC request whose `method` is not part
+    /// of the upstream typed `ClientRequest` enum (for example ACP
+    /// `session/new` / `session/prompt`). The request travels over the same
+    /// underlying `JsonRpcWire` as typed requests and the raw JSON-RPC result
+    /// (or error) is returned verbatim.
+    ///
+    /// This is intentionally minimal: it does not synthesize typed result
+    /// shapes and does not validate the method namespace. Callers are
+    /// responsible for serializing `params` into a JSON value the remote
+    /// understands and for decoding the returned `serde_json::Value`.
+    pub async fn send_raw_request(
+        &self,
+        method: &str,
+        params: Option<serde_json::Value>,
+    ) -> IoResult<RequestResult> {
+        let id = self.raw_request_counter.fetch_add(1, Ordering::Relaxed);
+        let request = JSONRPCRequest {
+            id: RequestId::String(format!("raw-{id}")),
+            method: method.to_string(),
+            params,
+            trace: None,
+        };
+        let (response_tx, response_rx) = oneshot::channel();
+        self.command_tx
+            .send(RemoteClientCommand::RawRequest {
+                request,
+                response_tx,
+            })
+            .await
+            .map_err(|_| {
+                IoError::new(
+                    ErrorKind::BrokenPipe,
+                    "remote app-server worker channel is closed",
+                )
+            })?;
+        response_rx.await.map_err(|_| {
+            IoError::new(
+                ErrorKind::BrokenPipe,
+                "remote app-server request channel is closed",
+            )
+        })?
     }
 
